  local function f27()
    local v89 = getgenv and getgenv() or _G
    v89.__RivoThrowState = rivoThrowState

    if flag5 or v89.__RivoThrowHooked then
      flag5 = true
      return true
    end

    if not (hookmetamethod and getnamecallmethod and setnamecallmethod and newcclosure
      and checkcaller) then
      return false, "executor does not support hookmetamethod/getnamecallmethod/setnamecallmethod/newcclosure/checkcaller"
    end

    local v90

    v90 = hookmetamethod(game, "__namecall", newcclosure(function(p123, ...)
      local namecallmethod = getnamecallmethod()
      local rivoThrowState2 = v89.__RivoThrowState

      local autoPerfect = namecallmethod == "InvokeServer" and rivoThrowState2
        and rivoThrowState2.alive
        and (rivoThrowState2.autoPerfect or rivoThrowState2.instantThrow)
        and not checkcaller()

      local packed

      if autoPerfect then
        local ok21, result16 = pcall(function()
          return typeof(p123) == "Instance" and p123.Name or nil
        end)

        if ok21 and result16 == "Throw_Resolve" then
          setnamecallmethod(namecallmethod)

          if rivoThrowState2.autoPerfect then
            packed = table.pack(v90(p123, 1, 1))
          else
            packed = table.pack(v90(p123, ...))
          end

          if rivoThrowState2.instantThrow and type(packed[1]) == "table" and packed[1].Ok then
            task.defer(function()
              task.wait(0.08)
              f21("Throw_Complete")
            end)
          end

          return table.unpack(packed, 1, packed.n)
        end
      end

      setnamecallmethod(namecallmethod)
      return v90(p123, ...)
    end))

    flag5 = true
    v89.__RivoThrowHooked = true
    return true
  end

