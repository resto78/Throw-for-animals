local function f1()
  count = count + 1

  if create then
    create:Cancel()
    create = nil
  end

  if create2 then
    create2:Cancel()
    create2 = nil
  end

  if connect then
    connect:Disconnect()
    connect = nil
  end

  if connect2 then
    connect2:Disconnect()
    connect2 = nil
  end

  local v3 = v2
  v2 = nil
  local create3

  if v3 then
    create3 = tweenService:Create(v3.frame, TweenInfo.new(
      0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In
    ), { Position = UDim2.new(1, 30, 1, 170), GroupTransparency = 1 })

    create3:Play()

    task.delay(0.35, function()
      create3:Destroy()
      v3.gui:Destroy()
    end)
  end
end

