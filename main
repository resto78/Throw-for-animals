if v1.RIVO_LOADED then
  local function getRivoHub(playerGui)
    return playerGui
      and (playerGui:FindFirstChild("RivoHub") or playerGui:FindFirstChild("RivoKeyGate"))
  end

  local playerGui2 = players.LocalPlayer:FindFirstChild("PlayerGui")
  local ok, result = pcall(function() return coreGui end)

  if getRivoHub(playerGui2) or ok and getRivoHub(result) then
    return warn("[Rivo] hub or key screen is already open; use RightShift or the K button")
  end

  v1.RIVO_LOADED = nil
end

