    pcall(f55, false)
    pcall(function() runService:Set3dRenderingEnabled(true) end)

    local humanoid5 = getHumanoid()

    if humanoid5 then
      pcall(function()
        humanoid5.WalkSpeed = 16
        humanoid5.JumpPower = 50
      end)
    end

    v1.RIVO_LOADED = nil

