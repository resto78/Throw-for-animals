  local function f12(text16)
    if type(text16) == "number" then
      return text16
    end

    if type(text16) ~= "string" then
      return nil
    end

    local upper2 = text16:gsub("[%s,]", ""):upper()

    if upper2 == "" then
      return nil
    end

    local v78, v79 = upper2:match("^(%d*%.?%d+)([KMBT]?)$")

    if not v78 then
      return nil
    end

    return tonumber(v78) * (({
      K = 1000,
      M = 1000000,
      B = 1000000000,
      T = 1000000000000,
    })[v79] or 1)
  end

